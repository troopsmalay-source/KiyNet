digraph ERD {
  graph [rankdir=LR, splines=ortho, nodesep=0.35, ranksep=0.55, bgcolor="white", pad=0.25, fontname="Arial", labelloc=t, label="KikiNet Logical ERD — Core Business + Network Read Models", fontsize=18, fontcolor="#14324A"];
  node [shape=record, style="filled", fillcolor="#F0F6F8", color="#90AAB8", fontname="Arial", fontsize=9, margin="0.10,0.07"];
  edge [color="#617F90", arrowsize=0.65, penwidth=1.0, fontname="Arial", fontsize=8];
  users [label="{USERS|id PK\lrole_id FK\lpartner_id FK?\l}"];
  roles [label="{ROLES|id PK\lname\l}"];
  partners [label="{PARTNERS|id PK\lcode UK\lstatus\l}"];
  customers [label="{CUSTOMERS|id PK\lpartner_id FK?\lcustomer_code UK\l}"];
  packages [label="{INTERNET_PACKAGES|id PK\ldownload_mbps\lupload_mbps\lprice_idr\l}"];
  subs [label="{SUBSCRIPTIONS|id PK\lcustomer_id FK\lpackage_id FK\lstatus\lpolicy_version\l}"];
  contracts [label="{PARTNER_BANDWIDTH_CONTRACTS|id PK\lpartner_id FK\lmax_rate_down/up\lcommit_rate optional\l}"];
  invoices [label="{INVOICES|id PK\lcustomer_id FK\lsubscription_id FK\lpartner_id snapshot\lperiod, totals, status\l}"];
  items [label="{INVOICE_ITEMS|id PK\linvoice_id FK\lprice/tax snapshots\l}"];
  payments [label="{PAYMENTS|id PK\linvoice_id FK\lamount, status\lprovider_reference\l}"];
  assign [label="{NETWORK_ACCESS_ASSIGNMENTS|id PK\lsubscription_id FK\lusername UK\lprofile/version\ldesired/applied state\l}"];
  profile [label="{NETWORK_ACCESS_PROFILES|id PK\lrate limits\lversion\l}"];
  outbox [label="{RADIUS_SYNC_OUTBOX|id PK\laggregate + command\lidempotency_key UK\lstatus, retry\l}"];
  nas [label="{NAS_DEVICES|id PK\lnas_identifier\lsecret refs\lstatus\l}"];
  sessions [label="{RADIUS_SESSIONS|id PK\lnas_id FK\lcustomer_id FK\lpartner_id snapshot\lstart/stop/bytes\l}"];
  samples [label="{RADIUS_ACCOUNTING_SAMPLES|id PK\lsession_id FK\lsampled_at + deltas\ldedupe_key UK\l}"];
  usage [label="{CUSTOMER_USAGE_DAILY|customer_id FK\lusage_date\lupload/download bytes\lcompleteness\l}"];
  pusage [label="{PARTNER_USAGE_DAILY|partner_id FK\lusage_date\lupload/download bytes\lcapacity/utilization\l}"];
  tax [label="{TAX_SUBMISSIONS|id PK\lpartner_id FK?\lperiod_id FK\lcategory, declared totals\lstatus/review\l}"];
  period [label="{TAX_PERIODS|id PK\lstarts_on / ends_on\ldue_on\l}"];
  token [label="{INVOICE_ACCESS_TOKENS|id PK\linvoice_id FK\ltoken_hash UK\lexpires/revoked\l}"];
  roles -> users [label="1 : N"];
  partners -> users [label="1 : N"];
  partners -> customers [label="1 : N"];
  customers -> subs [label="1 : N"];
  packages -> subs [label="1 : N"];
  partners -> contracts [label="1 : N"];
  subs -> invoices [label="1 : N"];
  invoices -> items [label="1 : N"];
  invoices -> payments [label="1 : N"];
  invoices -> token [label="1 : 0..1"];
  subs -> assign [label="1 : 0..1"];
  profile -> assign [label="1 : N"];
  partners -> sessions [label="1 : N (snapshot)"];
  customers -> sessions [label="1 : N"];
  nas -> sessions [label="1 : N"];
  sessions -> samples [label="1 : N"];
  customers -> usage [label="1 : N"];
  partners -> pusage [label="1 : N"];
  partners -> tax [label="1 : N"];
  period -> tax [label="1 : N"];
  subs -> outbox [style=dashed, label="policy commands"];
  assign -> outbox [style=dashed];
}
